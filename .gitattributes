# Force des fins de ligne LF pour les scripts executes dans des conteneurs
# Linux (Docker), quelle que soit la config Git de la machine qui clone
# (evite l'erreur "exit code: 127" quand mvnw est checkoute en CRLF sous Windows).
mvnw text eol=lf
*.sh text eol=lf

mvnw.cmd text eol=crlf
*.bat text eol=crlf

*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
