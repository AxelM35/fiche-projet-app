# Copier ce fichier en ".env" (non versionne) et renseigner les vraies valeurs.

# --- Base de donnees ---
DB_NAME=voyages_scolaires
DB_USER=voyages_user
DB_PASSWORD=changeme

# --- OAuth2 Google ---
# A creer dans Google Cloud Console > APIs & Services > Identifiants
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Domaine autorise a se connecter ---
ALLOWED_EMAIL_DOMAIN=college-sthelier.fr

# --- Listes d'emails par role (separees par des virgules) ---
ROLES_ADMIN=amorvan@college-sthelier.fr
ROLES_COMPTA=compta@college-sthelier.fr
ROLES_VIESCO=viesco@college-sthelier.fr
ROLES_DIRECTION=direction@college-sthelier.fr
# Observateurs en lecture seule (secretariat...) : vide par defaut, aucun impact si non renseigne.
ROLES_LECTURE_SEULE=

# --- SMTP (notifications de workflow) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@college-sthelier.fr

# --- Divers ---
APP_BASE_URL=http://localhost:8080

# --- Google Drive (creation automatique du dossier de pieces jointes) ---
# Desactive par defaut : sans configuration, le lien Drive se saisit a la
# main sur la fiche projet (aucun impact si les variables ci-dessous sont
# absentes). Pour activer : creer un compte de service dans Google Cloud
# Console (API Drive activee), partager un Drive partage de l'etablissement
# avec l'adresse email de ce compte de service (role "Gestionnaire de
# contenu"), puis renseigner :
GOOGLE_DRIVE_ENABLED=false
# Identifiant du Drive partage (visible dans l'URL Drive : .../drive/folders/<id>)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Cle JSON du compte de service, encodee en base64 (ex: base64 -w0 cle.json)
GOOGLE_DRIVE_CREDENTIALS_JSON_BASE64=

# --- Sauvegardes PostgreSQL automatiques (service db-backup) ---
# Format cron ou raccourcis (@daily, @weekly...). Dumps ecrits dans ./backups/{daily,weekly,monthly,last}.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
