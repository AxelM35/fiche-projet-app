# Copier ce fichier en ".env" (non versionne) et renseigner les vraies valeurs.

# --- Base de donnees ---
DB_NAME=voyages_scolaires
DB_USER=voyages_user
DB_PASSWORD=changeme

# --- OAuth2 Google ---
# A creer dans Google Cloud Console > APIs & Services > Identifiants
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Domaine autorise a se connecter ---
ALLOWED_EMAIL_DOMAIN=exemple.fr

# --- Listes d'emails par role (separees par des virgules) ---
ROLES_ADMIN=amorvan@exemple.fr
ROLES_COMPTA=compta@exemple.fr
ROLES_VIESCO=viesco@exemple.fr
ROLES_DIRECTION=direction@exemple.fr

# --- SMTP (notifications de workflow) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemple.fr

# --- Divers ---
APP_BASE_URL=http://localhost:8080
