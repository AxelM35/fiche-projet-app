# Copier ce fichier en ".env" (non versionné) et renseigner les vraies valeurs.

# --- Base de données ---
DB_NAME=fiche_projet
DB_USER=fiche_projet_user
DB_PASSWORD=changeme

# --- OAuth2 Google ---
# À créer dans Google Cloud Console > APIs & Services > Identifiants
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Domaine autorisé à se connecter ---
ALLOWED_EMAIL_DOMAIN=exemple.fr

# --- Listes d'emails par rôle (séparées par des virgules) ---
ROLES_ADMIN=admin@domaine.com
ROLES_COMPTA=compta@exemple.fr
ROLES_VIESCO=viesco@exemple.fr
ROLES_DIRECTION=direction@exemple.fr
# Observateurs en lecture seule (secrétariat...) : vide par défaut, aucun impact si non renseigné.
ROLES_LECTURE_SEULE=

# --- SMTP (notifications de workflow) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemple.fr

# --- Divers ---
APP_BASE_URL=http://localhost:8080

# --- Google Drive (création automatique du dossier de pièces jointes) ---
# Désactivé par défaut : sans configuration, le lien Drive se saisit à la
# main sur la fiche projet (aucun impact si les variables ci-dessous sont
# absentes). Pour activer : créer un compte de service dans Google Cloud
# Console (API Drive activée), partager un Drive partagé de l'établissement
# avec l'adresse email de ce compte de service (rôle "Gestionnaire de
# contenu"), puis renseigner :
GOOGLE_DRIVE_ENABLED=false
# Identifiant du Drive partagé (visible dans l'URL Drive : .../drive/folders/<id>)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Clé JSON du compte de service, encodée en base64 (ex : base64 -w0 cle.json)
GOOGLE_DRIVE_CREDENTIALS_JSON_BASE64=

# --- Relances automatiques sur dossiers bloqués ---
# Première relance envoyée au rôle valideur en attente après ce nombre de
# jours de blocage sur une étape, puis répétée tous les RELANCES_PERIODE_JOURS
# tant que le dossier reste bloqué (tâche quotidienne à 8h).
RELANCES_SEUIL_JOURS=7
RELANCES_PERIODE_JOURS=7

# --- Sauvegardes PostgreSQL automatiques (service db-backup) ---
# Format cron ou raccourcis (@daily, @weekly...). Dumps écrits dans ./backups/{daily,weekly,monthly,last}.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
